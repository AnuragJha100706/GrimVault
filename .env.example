# ==============================================================================
# DevVault Environment Configuration Template
# Copy this file to '.env' and update variables to match your environment.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=devvault-super-secure-key-change-in-production

# Local Projects Storage Root (Configurable directory for local project folders)
# Default on Windows: E:\COMPLETE PROJECT
# Example for Linux/macOS: /home/username/projects or ./local_projects
LOCAL_PROJECTS_DIR=E:\COMPLETE PROJECT

# GitHub Integration Settings (Optional: Increases rate limit from 60 to 5,000 req/hr)
GITHUB_USERNAME=AnuragJha100706
GITHUB_TOKEN=

